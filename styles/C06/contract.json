  "recipe": {
    "positive": "Visual style (follow exactly): in the style of Quentin Blake's loose ink-and-watercolour illustrations (Roald Dahl books). Loose ink-and-wash storybook illustration: jittery, scratchy dip-pen ink lines drawn fast and confidently, loose transparent watercolour washes that do not fill the outlines exactly, exaggerated long limbs and lively gestures, expressive tiny faces, lots of white paper, energetic quick-sketch feeling, warm and humorous.",
    "text_mode": [
      "native",
      "overlay",
      "none"
    ]
  },
  "palette": {
    "recolor": "free"
  },
  "qa": {
    "must_see": [
      "快速抖动的蘸水笔墨线",
      "松散透明水彩",
      "夸张肢体与白纸留白"
    ],
    "must_not_see": [
      "精密矢量线或厚涂水彩",
      "未请求的文字或水印"
    ]
  },
