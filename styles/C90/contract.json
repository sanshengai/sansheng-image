  "qa": {
    "must_see": [
      "深色底、留出安静的文字区",
      "文字区品牌名加系列标签加超大主标题",
      "主体区一个认得出的主体加暖色圆日与剪影",
      "只有一个暖色强调加米金细线"
    ],
    "must_not_see": [
      "霓虹光效堆砌",
      "标题被方框圈住",
      "未请求的文字或水印"
    ],
    "when_text": [
      "文字区品牌名加系列标签加超大主标题"
    ]
  },
