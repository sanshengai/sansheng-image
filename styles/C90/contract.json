  "essence": [
    "深色底，左侧自上而下：品牌名一行小字、系列标签（圆角色块）、超大粗衬线主标题",
    "右侧一个认得出的主体（可多件叠放）加一轮暖色圆日与剪影",
    "只用一个暖色强调（橙红）加米金细线，其余深色"
  ],
  "recipe": {
    "positive": "Visual style (follow exactly): a premium dark series cover for articles in a numbered series. Deep aubergine-black canvas (#1B1624). Two zones (where each sits is given by the layout line): a text zone kept dark and calm with a thin champagne-gold rule near its lower part, and a hero zone with one clearly recognisable hero subject (several overlapping items allowed) with a large flat warm-coloured sun disc and a dark silhouette skyline or landscape behind it, flat graphic shapes with fine paper grain; cinematic, calm and premium; no neon, no glow, no gradient starfield, no frames or boxes around the headline.",
    "required_text_roles": [
      "title",
      "brand",
      "tag"
    ],
    "role_styles": {
      "brand": "The brand line is small and sits at the top of the text zone with a thin underline beneath it.",
      "tag": "The series tag is a small rounded chip in warm orange-red (#E8704E) below the brand line, carrying exactly the given series name.",
      "title": "The headline is a very large bold serif in warm off-white (#F5EDE0) on one or two lines below the tag chip, with the thin champagne-gold rule beneath it."
    },
    "layout": {
      "text_zone": "left",
      "hero_zone": "right"
    },
    "text_mode": [
      "native",
      "none"
    ]
  },
