  "recipe": {
    "positive": "Dunhuang cave-mural technique: mineral pigments (malachite green, azurite blue, cinnabar red, ochre, oxidised lead white) applied as flat, slightly worn colour fields on rough clay-plaster rock wall, with visible wall grain, hairline cracks, pigment flaking and fading. Flowing iron-wire-like dark outlines define forms and remain darker than the plaster. Decorative lotus and cloud-scroll patterns appear on textiles, borders and open wall surfaces only; do not add deities, Buddhas or figures not present in the current brief. The mural surface feels earth-mineral, matte, aged and hand-painted, with uneven worn edges and readable pigment fields. Earthy mineral palette: malachite green, azurite blue, cinnabar red, ochre, faded cream-white, carbon-black line, on warm brown-grey plaster. Use only text the current brief explicitly requests; otherwise no text.",
    "hard_constraints": [
      "Visible rough clay-plaster wall grain, hairline cracks, pigment flaking and fading.",
      "Mineral pigment colour fields in malachite green, azurite blue, cinnabar red, ochre and faded cream-white, with carbon-black line.",
      "Flowing iron-wire-like dark outlines; no smooth digital vector look.",
      "Matte mineral surface; no glossy gold foil.",
      "No cave photograph, no added deities, Buddhas or figures beyond the current brief, and no text unless explicitly requested."
    ],
    "text_mode": [
      "none",
      "native"
    ]
  },
  "palette": {
    "recolor": "free"
  },
  "qa": {
    "must_see": [
      "泥灰岩壁肌理清晰可见，含少量细裂纹与局部褪色",
