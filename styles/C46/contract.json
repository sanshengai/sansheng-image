    "must_see": [
      "泛黄旧纸与历史档案质感",
      "细墨线边框、植物角饰或克制抽象档案纹样",
      "克制棕褐和灰橄榄色层次"
    ],
    "must_not_see": [
      "明亮科技色或纯白无纹理底",
      "未请求的罗盘、方位字母、手写痕迹、文字或水印"
