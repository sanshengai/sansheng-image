  "essence": [
    "毛绒、雪尼尔线的玩偶角色",
    "看得见的蓬松纤维与针织纹理",
    "圆润柔软的造型",
    "冰淇淋马卡龙亮色",
    "柔和棚拍光，治愈可爱"
  ],
  "recipe": {
    "positive": "Visual style (follow exactly): in the style of plush toy 3D render like Jellycat soft toys. Fuzzy plush-toy 3D characters: healing, cuddly plush and chenille yarn dolls, realistic fluffy fibres and knitted texture, rounded soft shapes, bright ice-cream macaron colours, soft studio lighting, cute and cosy. Keep the bright ice-cream macaron colours even in evening, outdoor or night scenes.",
    "text_style": "Titles and labels look like soft felt or plush lettering in the same macaron colours.",
    "text_mode": [
      "native",
      "overlay",
      "none"
    ]
  },
  "prompt_bans": [
    "photorealistic",
    "horror",
    "metallic",
    "dark background"
  ],
  "palette": {
    "recolor": "free"
  },
  "qa": {
    "must_see": [
      "characters and objects look like plush or chenille yarn toys with visible fluffy fibres",
      "rounded soft shapes",
      "bright ice-cream macaron colours",
      "soft, even lighting with a cosy feel"
    ],
    "must_not_see": [
      "large hard plastic, clay or glossy surfaces (small bead eyes and noses on plush toys are fine)",
      "realistic human skin or photographic people",
      "dark, gloomy or harsh lighting",
      "flat 2D illustration without fibre texture"
    ]
  },
