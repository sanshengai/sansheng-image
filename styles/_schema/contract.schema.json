{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanshengai/sansheng-image/styles/_schema/contract.schema.json",
  "title": "Style contract (风格合同)",
  "description": "One style = one contract. Machine-checkable: compile-time bans, post-generation checks, pixel thresholds, evidence and revision.",
  "type": "object",
  "required": [
    "code",
    "revision",
    "name",
    "family",
    "fit",
    "visibility",
    "source",
    "essence",
    "recipe",
    "palette",
    "qa"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^(C|S)[0-9]{2,3}$",
      "description": "风格码，如 C31；S 开头为自用私有风格"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "修订号；项目锁定写作 C31@r2"
    },
    "name": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "fit": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "讲故事",
          "讲道理",
          "封面"
        ]
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "medium": {
          "type": "string"
        },
        "mood": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "use": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "density": {
          "enum": [
            "极简留白",
            "中等",
            "细节丰富"
          ]
        },
        "region": {
          "type": "string"
        }
      }
    },
    "abilities": {
      "type": "object",
      "additionalProperties": false,
      "description": "能力标签，只能来自测试题实测",
      "properties": {
        "character_consistency": {
          "$ref": "#/$defs/level"
        },
        "chinese_text": {
          "$ref": "#/$defs/level"
        },
        "video_frame": {
          "$ref": "#/$defs/level"
        },
        "long_series": {
          "$ref": "#/$defs/level"
        },
        "kids": {
          "$ref": "#/$defs/level"
        },
        "adds_people": {
          "type": "boolean",
          "description": "无人场景也会画出人物（角色立绘型配方）"
        }
      }
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "from",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "enum": [
            "original",
            "MIT",
            "CC0"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "essence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 4
      },
      "description": "命门：不能妥协的视觉特征"
    },
    "recipe": {
      "type": "object",
      "required": [
        "positive"
      ],
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "string",
          "minLength": 40,
          "description": "正向配方全文（锁定层，编译时原样使用，不许改写）"
        },
        "text_style": {
          "type": "string",
          "minLength": 20,
          "description": "图里有字（原生写字）时才附上的文字材质描述；无字的图不加，避免诱导模型加字"
        },
        "text_style_hybrid": {
          "type": "string",
          "minLength": 20,
          "description": "hybrid 模式专用文字材质描述；不改变 native 与无字模式的提示词"
        },
        "structure_prompts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 20
          },
          "description": "仅在清单明确指定对应 structure 时加入的样式布局规则"
        },
        "constraints_first": {
          "type": "boolean",
          "description": "硬约束是否前置（按测试题结果定）"
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "已改写成正面描述的硬约束"
        },
        "text_mode": {
          "type": "array",
          "items": {
            "enum": [
              "native",
              "overlay",
              "hybrid",
              "none"
            ]
          },
          "description": "适合的文字档位"
        },
        "required_text_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "本画风要求画面里出现的文字角色（如 ghost）。图里有字（native / hybrid / overlay 且给了 text.items）时，清单缺这些角色就在编译期报错；无字档不检查"
        },
        "optional_text_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "本画风可以出现、但清单不给也成立的文字角色"
        },
        "role_styles": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 20
          },
          "description": "按文字角色写的呈现方式；只有清单真的给了该角色的文字才附进提示词。键必须是 required_text_roles 或 optional_text_roles 里的角色"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text_zone": {
              "enum": [
                "left",
                "right",
                "top",
                "bottom"
              ],
              "description": "文字区在画面哪一侧"
            },
            "hero_zone": {
              "enum": [
                "left",
                "right",
                "top",
                "bottom"
              ],
              "description": "主体区在画面哪一侧"
            },
            "wide_canvas_only": {
              "type": "boolean",
              "description": "true 表示版式必须用到整幅宽画布，经不起居中方形裁切；与带 center_square 安全区的格式同用时编译直接报错"
            }
          },
          "description": "机器可读的版式声明：配方正文只写分区，不靠英文方位词去猜"
        }
      }
    },
    "prompt_bans": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "编译期冲突词：提示词里出现就拦截"
    },
    "palette": {
      "type": "object",
      "required": [
        "recolor"
      ],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          }
        },
        "recolor": {
          "enum": [
            "locked",
            "lightness_only",
            "free"
          ],
          "description": "换色程度"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "isolation": {
          "type": "string"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string"
            },
            "item": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "must_see",
        "must_not_see"
      ],
      "additionalProperties": false,
      "properties": {
        "must_see": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "must_not_see": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "mode_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hybrid": {
              "type": "object",
              "required": [
                "must_see",
                "must_not_see"
              ],
              "additionalProperties": false,
              "properties": {
                "must_see": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 4
                  }
                },
                "must_not_see": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 4
                  }
                },
                "when_text": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "pixel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mean_luma_min": {
              "type": "number"
            },
            "mean_luma_max": {
              "type": "number"
            },
            "dark_pixel_luma": {
              "type": "number"
            },
            "dark_pixel_ratio_max": {
              "type": "number"
            },
            "mean_saturation_max": {
              "type": "number"
            },
            "mean_saturation_min": {
              "type": "number"
            },
            "white_ratio_min": {
              "type": "number"
            }
          }
        },
        "pixel_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "像素阈值只对这些版式族或格式 id 生效；不填则对所有格式生效"
        },
        "center_square_margin_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "description": "需居中方形裁切的格式中，高对比内容距实际方形四边的最小比例；仍须独立看图"
        },
        "paper_margin_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "description": "暖色纸底上可检测墨线和明显色块距四边的最小比例；浅色细节仍须看图"
        },
        "paper_margin_min_by_text_mode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "none": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            },
            "native": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            },
            "overlay": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            },
            "hybrid": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            }
          },
          "description": "按文字模式覆盖 paper_margin_min；未列出的模式沿用通用阈值"
        },
        "overlay_layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headline_min_font_px_ratio": {
              "type": "number",
              "description": "标题 font_px 占最终画布高度的必要下限；范围 (0, 0.5]"
            },
            "subtitle_max_lines": {
              "type": "integer",
              "minimum": 1
            }
          },
          "minProperties": 1,
          "description": "叠字版式的必要条件；字号相对最终画布高度，仅能排除明显过小，不能代替实际字高看图"
        },
        "when_text": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "只在图里有文字时才检查的条目（必须是 must_see 或 must_not_see 中的原文）"
        },
        "wide_content_span_min": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.95,
          "description": "深色宽幅品牌封面的可见内容跨度下限，排除底部水印；空图和中央小图必须拒绝，语义仍独立看图"
        }
      }
    },
    "drifts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symptom",
          "fix"
        ],
        "additionalProperties": false,
        "properties": {
          "symptom": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "model_variants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "append": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "pass",
              "fail",
              "na",
              "pending"
            ]
          }
        },
        "admission": {
          "enum": [
            "admitted",
            "pending",
            "rejected",
            "hold"
          ]
        },
        "model": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "prior": {
          "type": "object",
          "description": "上一修订的准入记录（改配方后旧准入不再适用，仅留档）"
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision",
          "date",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "inspiration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "原作者、工作室、作品（展示用，公开）"
        },
        "prompt": {
          "type": "string",
          "description": "进提示词的英文短语；无具体来源时为空字符串"
        }
      }
    },
    "uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "封面",
          "文章插图",
          "小红书",
          "信息图",
          "PPT",
          "漫画",
          "绘本",
          "分镜",
          "音乐封面",
          "教材"
        ]
      },
      "description": "适合的用途；选了用途只列出打勾的画风"
    },
    "renderer": {
      "enum": [
        "codex",
        "openai",
        "any"
      ],
      "description": "首选出图后端"
    },
    "motion_dialect": {
      "type": "object",
      "required": [
        "language",
        "primitives",
        "safety"
      ],
      "additionalProperties": false,
      "description": "动态导演建议：画风的运动材质与节奏。不影响静态出图提示词，也不证明自动成片或静态准入",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "一两句运动材质与节奏描述，不绑定固定样图的人物、剧情或动作"
        },
        "primitives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "keyframes",
              "easing",
              "spring",
              "squash",
              "particles",
              "light_sweep",
              "mask_reveal",
              "card_flip",
              "char_text",
              "number_roll",
              "path_draw",
              "loop"
            ]
          },
          "description": "建议的动作类别（对应 references/motion-primitives.md 的十二类），不是自动调用的函数名"
        },
        "safety": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "文字、人脸、产品等受保护内容的运动边界"
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "file"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "renderer": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "ratio": {
            "type": "number",
            "minimum": 0.1,
            "description": "样图宽高比（宽/高，保留三位）。公开下载包不带样图文件，选择器据此无图重建"
          },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "prompt_sha256",
              "attempts",
              "picked_from"
            ],
            "description": "样图生成记录。2026-10-13 起登记的样图必须带；没有的是「历史样图」（未记录挑选）",
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "出图时该画风合同的修订号；小于当前修订即「待重出」"
              },
              "prompt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "生图提示词正文（不含调用工具的包装指令）的 sha256，UTF-8"
              },
              "attempts": {
                "type": "integer",
                "minimum": 1,
                "description": "第几次出图得到这张（含失败重试）"
              },
              "picked_from": {
                "type": "integer",
                "minimum": 1,
                "description": "从几张合格图里挑出这张；1 即单次出图、未挑选"
              },
              "edited": {
                "type": "boolean",
                "description": "是否经过后期编辑（裁切、修字、局部重绘）"
              }
            }
          }
        }
      },
      "description": "同题样图（人物 / 物件 / 信息图）"
    },
    "exemplars": {
      "type": "array",
      "description": "按内容命中才挂的范例参考图（单次请求参考图总数 ≤ 3）。character=人物画法，graphic=图示画法",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "file",
          "sha256",
          "contains"
        ],
        "properties": {
          "kind": {
            "enum": [
              "character",
              "graphic"
            ]
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "enabled": {
            "type": "boolean"
          },
          "contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isolation": {
            "type": "string"
          }
        }
      }
    },
    "translation_rules": {
      "type": "object",
      "description": "参考图覆盖不到的内容怎么用这个画风画；unsuitable 写明本画风不适合的内容",
      "additionalProperties": false,
      "properties": {
        "people": {
          "type": "string"
        },
        "animals": {
          "type": "string"
        },
        "surfaces": {
          "type": "string"
        },
        "glyphs": {
          "type": "string"
        },
        "diagrams": {
          "type": "string"
        },
        "unsuitable": {
          "type": "string"
        }
      }
    },
    "palette_spec": {
      "type": "array",
      "description": "5–7 个色块：名字、hex、作用、面积占比",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hex",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "role": {
            "type": "string"
          },
          "area": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "level": {
      "enum": [
        "good",
        "ok",
        "weak",
        "unknown"
      ]
    },
    "color": {
      "type": "object",
      "required": [
        "name",
        "hex"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "hex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "role": {
          "type": "string"
        }
      }
    }
  }
}
