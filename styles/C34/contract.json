  },
  "essence": [
    "杂志式信息层级与几何编排",
    "写实摄影或精绘材质的主场景",
    "有限局部细节视图与克制留白"
  ],
  "recipe": {
    "positive": "Visual style (follow exactly): Polished magazine editorial collage with a large primary scene and a small number of purposeful detail insets. Render subjects with realistic photographic or carefully painted material detail, embedded in restrained geometric colour fields, thin editorial rules and generous ivory negative space. Preserve realistic lighting, perspective and texture within each scene; geometric framing does not flatten the subject into mid-century vector illustration. Use structured visual hierarchy. Detail insets may repeat existing objects from the main scene, but must not invent new subjects or extra physical instances. When no text is requested, hierarchy comes from framing and size alone; never add headline placeholders, labels or pseudo-text.",
    "text_mode": [
      "native",
      "overlay",
      "none"
    ]
  },
  "palette": {
    "recolor": "free"
  },
  "qa": {
    "must_see": [
      "真实材质的主场景与几何色域编排",
      "主次明确的编辑式信息层级",
      "有限细节视图只展示当前任务已有物件，不擅加其他主题"
    ],
    "must_not_see": [
      "拥挤无序排版或缺少真实材质的扁平色块插画",
      "未请求的文字或水印"
    ]
  },
  "evidence": {
