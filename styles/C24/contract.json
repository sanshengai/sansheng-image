  "name": {
    "zh": "黏土定格",
    "en": "Clay Stop-motion"
  },
  "family": "立体材质",
  "fit": [
    "讲故事",
    "讲道理"
  ],
  "facets": {
    "medium": "橡皮泥定格",
    "mood": [
      "童趣",
      "温暖"
    ],
    "use": [
      "表情包",
      "公众号配图",
      "绘本"
    ],
    "density": "中等"
  },
  "visibility": "public",
  "source": {
    "from": "yang0/handraw-style #248（描述已改写）与 baoyu-skills@1567581 claymation",
    "license": "MIT",
    "notes": "压缩成正面描述；文字规格改为「字独立站在场景里、周围留空」（写作技能实测否定式挡不住底板） C24@r4 锚点改为由 q1 生成的无题材黏土材质板，以减少餐具花纹、厨房人物和布景串入。"
  },
  "essence": [
    "一切物体都是橡皮泥手捏",
    "看得见的指纹和小瑕疵",
    "圆润的雕塑造型与柔和阴影",
    "微缩布景的定格动画感",
    "饱和但略哑的黏土色，中性棚拍背景"
  ],
  "recipe": {
    "positive": "Visual style (follow exactly): in the style of Aardman Animations claymation (Wallace & Gromit). 3D clay-figure stop-motion aesthetic: every object is made of plasticine with visible fingerprint marks and small imperfections, rounded sculpted forms, soft shadows and a miniature-set feel. Saturated but slightly muted clay colours against a neutral studio backdrop with soft gradients, complementary clay accents and gentle highlights. Every surface in the scene, including wood, stone, fabric, water and fur, is plasticine with the same fingerprinted clay texture, so the whole picture looks like a handmade miniature set.",
    "text_style": "Titles and labels are sculpted from the same plasticine as the objects, standing free in the scene with open space around them.",
    "text_mode": [
      "native",
      "overlay",
      "none"
    ]
  },
  "prompt_bans": [
    "flat vector",
    "photorealistic",
    "line art"
  ],
  "palette": {
    "recolor": "free"
  },
  "qa": {
    "must_see": [
      "all objects look sculpted from plasticine with visible fingerprints or small imperfections",
      "rounded sculpted forms with soft shadows",
      "miniature stop-motion set feel",
      "saturated but slightly muted clay colours"
    ],
    "must_not_see": [
      "flat 2D illustration or line art",
      "photorealistic or glossy plastic surfaces",
      "dark, harsh lighting",
      "all or most text items enclosed by backing plates, boxes or cards"
    ],
    "when_text": [
      "all or most text items enclosed by backing plates, boxes or cards"
    ]
  },
  "drifts": [
    {
      "symptom": "文字压在黏土底板上",
      "fix": "文字规格写成「字独立站在场景里、周围留空」的正面描述，不写「不要底板」"
    }
  ],
