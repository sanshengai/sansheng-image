  "essence": [
    "大面积安静留白",
    "主体周围的安静纸面",
    "细腻的手绘细线",
    "淡淡的水彩晕染",
    "童真好奇又带一点安静的忧伤"
  ],
  "recipe": {
    "positive": "Visual style (follow exactly): in the style of Jimmy Liao's dreamy, poetic picture-book illustrations. Poetic picture-book illustration on very pale cream paper: delicate fine hand-drawn lines, soft translucent pale watercolour washes, a gentle quiet dreamy mood. Keep every action-essential figure and object fully inside the central 58% of the canvas width, with unbroken calm paper margins on both left and right and a broad continuous empty area above. In close and medium shots the human or animal silhouettes are complete and easy to read without touching the frame edges. Show only the props required to understand the action; furniture and distant setting are a few very faint thin lines, with no collection of tabletop objects. In wide shots leave a large calm paper area and make setting details small and light. Preserve the exact subject, gesture, facial identifiers and required objects from the task.",
    "text_style": "Any text is small, light hand-lettering resting in the empty space.",
    "text_mode": [
      "none",
      "overlay"
    ]
  },
  "prompt_bans": [
    "crowded",
    "neon",
    "photorealistic",
    "saturated"
  ],
  "palette": {
    "recolor": "free"
  },
  "qa": {
    "must_see": [
      "very large calm areas of clean empty space",
      "delicate fine hand-drawn lines with soft pale watercolour washes",
      "a generous calm empty area around the main subject, even in close-ups",
      "gentle, quiet, dreamy mood"
    ],
    "must_not_see": [
      "dense, busy composition filling the frame",
      "saturated or dark heavy colours",
      "thick outlines or cartoon cel-shading",
      "photographic or 3D-rendered look"
    ]
  },
  "drifts": [
    {
      "symptom": "讲解题的文字偏小偏淡",
      "fix": "字多时用 overlay 档位，事后排字"
    }
  ],
