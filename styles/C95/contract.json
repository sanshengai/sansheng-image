      }
    ],
    "recolor": "locked"
  },
  "qa": {
    "must_see": [
      "黑底白线或黑色剪影的拓印质感，含石面颗粒小坑与细裂纹",
      "侧面剪影造型古拙，阴刻平行线表现衣纹与纹理",
      "可行时为横向分层排布，云纹或几何纹填充"
    ],
    "must_not_see": [
      "彩色或带投影的灰色立体石材",
      "石碑照片、石框或碑额边饰",
      "任何铭文、假文字或签名"
    ]
  },
