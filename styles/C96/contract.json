  "recipe": {
    "positive": "Visual style (follow exactly): fairy-tale book illustration technique inspired by early-20th-century folk-tale picture books: uniform confident black pen and ink outlines, flat transparent watercolour fills, rich folk ornament on wood, textiles and plants, stylised decorative foliage, flattened storybook depth, and a decorative folk-pattern border frame around the image whose pattern area contains no letters. Technique reference only. Figures, faces, hair, clothing and objects come only from the current brief, including modern clothing; the folk ornament decorates surfaces and the border and is never imposed as period costume on the people. Default colour tendency when no palette is requested: Warm earth and folk colours: deep red, forest green, ochre, indigo, cream paper, black ink line. If the brief explicitly requests a recolour, retain the same limited colour roles, line contrast and material character.",
    "hard_constraints": [
      "Pen lines keep an even weight and shading comes from flat watercolour fields rather than hatching.",
      "The border frame holds only folk pattern and leaves the subject's information area clear."
    ],
    "text_mode": [
      "none"
    ]
  },
  "palette": {
    "recolor": "free"
  },
